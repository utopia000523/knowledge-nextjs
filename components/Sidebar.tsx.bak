'use client';

interface SidebarProps {
  categories: string[];
  categoryCounts: Record<string, number>;
  activeCategory: string | null;
  onCategoryChange: (category: string | null) => void;
  articleCount: number;
  readCount: number;
}

export default function Sidebar({ 
  categories, 
  categoryCounts,
  activeCategory, 
  onCategoryChange, 
  articleCount,
  readCount
}: SidebarProps) {
  return (
    <div className="w-[280px] h-screen fixed left-0 top-0 bg-[rgba(15,20,35,0.95)] backdrop-blur-lg border-r border-white/10 p-8 flex flex-col overflow-y-auto">
      {/* Header */}
      <div className="pb-6 border-b border-white/10">
        <h1 className="text-2xl font-semibold text-white mb-2">知识库</h1>
        <p className="text-sm text-gray-500">个人学习笔记整理</p>
        <p className="text-xs text-gray-600 mt-2">已读 {readCount} / {articleCount} 篇</p>
      </div>

      {/* Categories */}
      <div className="pt-6">
        <p className="text-xs text-gray-600 mb-3 uppercase tracking-wider">分类</p>
        
        {/* All */}
        <div 
          className={`px-4 py-3 mb-1 rounded-lg cursor-pointer transition-all flex justify-between items-center ${
            activeCategory === null 
              ? 'bg-indigo-500/20 text-indigo-300' 
              : 'hover:bg-white/10 text-gray-400'
          }`}
          onClick={() => onCategoryChange(null)}
        >
          <span>全部</span>
          <span className={`text-xs px-2 py-1 rounded ${
            activeCategory === null 
              ? 'bg-indigo-500/30 text-indigo-300' 
              : 'bg-white/10 text-gray-600'
          }`}>
            {articleCount}
          </span>
        </div>

        {/* Category list */}
        {categories.map((category) => (
          <div 
            key={category}
            className={`px-4 py-3 mb-1 rounded-lg cursor-pointer transition-all flex justify-between items-center ${
              activeCategory === category 
                ? 'bg-indigo-500/20 text-indigo-300' 
                : 'hover:bg-white/10 text-gray-400'
            }`}
            onClick={() => onCategoryChange(category)}
          >
            <span>{category}</span>
            <span className={`text-xs px-2 py-1 rounded ${
              activeCategory === category 
                ? 'bg-indigo-500/30 text-indigo-300' 
                : 'bg-white/10 text-gray-600'
            }`}>
              {categoryCounts[category] || 0}
            </span>
          </div>
        ))}
      </div>
    </div>
  );
}